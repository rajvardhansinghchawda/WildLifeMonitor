# Application & Environment
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:5173"]

# Persistence & Queue
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/wildlife
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO / S3)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=wildlife-artifacts
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadminpassword

# Authentication (development or oidc)
AUTH_MODE=development
OIDC_ISSUER=
OIDC_AUDIENCE=

# External Providers
GEE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GFW_ENABLED=false
GFW_API_KEY=
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Scientific & Operational Limits
MAX_AOI_KM2=2500.0
MAX_AOI_VERTICES=5000
MAX_ACTIVE_JOBS_PER_WORKSPACE=2

# Grounded chat agent (Groq)
GROQAPIKEY=
GROQMODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
CHATMAXLOOPITERATIONS=5
CHATMAXHISTORYTURNS=10
